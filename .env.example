# Copy real values with `vercel env pull .env.local --yes` (see README). Never commit real values.

# Neon Postgres, set by the Vercel Marketplace integration: pooled for the app, direct for `pnpm setup-db`
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth: a random string of at least 32 characters, different for each environment
BETTER_AUTH_SECRET=

# AWS Textract
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2
